# Copie este archivo como .env y complete los valores reales.
# .env nunca debe subirse al repositorio.

SECRET_KEY=generar-una-clave-larga-y-aleatoria
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres?sslmode=require

# Opcionales: respaldos y trazabilidad
# AFO_BACKUP_DIR=backups
# AFO_BACKUP_RETENTION=14
# AFO_BACKUP_TIMEOUT=900
# AFO_BACKUP_PG_DUMP=pg_dump
# AFO_TRUST_X_FORWARDED_FOR=0
# AFO_ACCESS_LOG_RETENTION_DAYS=365
